# Copia questo file in ".env" e inserisci i tuoi valori. Il file ".env" NON va mai committato.

# --- Database (devono coincidere con docker-compose.yml) ---
SCOUTAI_DB_NAME=scoutai
SCOUTAI_DB_USER=scoutai
SCOUTAI_DB_PASSWORD=scoutai
SCOUTAI_DB_PORT=5432

# --- API-Football (https://dashboard.api-football.com -> My Access -> API Key) ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Sicurezza ---
# Chiave per gli endpoint /api/v1/admin/** (inventane una lunga e casuale)
ADMIN_API_KEY=
# Origine del frontend ammessa dal CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173
