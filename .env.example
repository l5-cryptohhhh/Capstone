# Copia questo file in ".env" e inserisci i tuoi valori. Il file ".env" NON va mai committato.

# --- Database (devono coincidere con docker-compose.yml) ---
SCOUTAI_DB_NAME=scoutai
SCOUTAI_DB_USER=scoutai
SCOUTAI_DB_PASSWORD=scoutai
SCOUTAI_DB_PORT=5432

# --- API-Football (https://dashboard.api-football.com -> My Access -> API Key) ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Solo per modelli che ragionano (gpt-oss su Groq): low riduce i token usati
OPENROUTER_REASONING_EFFORT=

# --- Sicurezza ---
# Chiave per gli endpoint /api/v1/admin/** (inventane una lunga e casuale)
ADMIN_API_KEY=
# Origine del frontend ammessa dal CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Solo online (su Render queste variabili si impostano nella dashboard, vedi docs/deploy.md) ---
# Su Render host, porta, nome, utente e password del database arrivano da soli (vedi render.yaml): non servono qui.
# Per un database ospitato altrove: SCOUTAI_DB_HOST, oppure l'indirizzo JDBC completo (ha la precedenza):
# SCOUTAI_DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# Dietro il proxy di Render: legge l'IP vero del client (valori: none, native)
# SERVER_FORWARD_HEADERS_STRATEGY=native
# Spegne l'import automatico interno: online lo lancia il workflow GitHub giornaliero
# SCOUTAI_IMPORT_AUTO_ENABLED=false
